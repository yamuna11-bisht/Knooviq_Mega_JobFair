{
  "name": "college-student-registration-system",
  "version": "1.0.0",
  "description": "Professional College Student Registration Form with CV Upload, Admin Dashboard, and Centralized Excel Integration",
  "main": "server/index.js",
  "scripts": {
    "dev:server": "node server/index.js",
    "dev:client": "npm --prefix client run dev",
    "dev": "node server/index.js",
    "build:client": "npm --prefix client run build",
    "build": "npm run build:client",
    "tunnel": ".\\cloudflared.exe tunnel --url http://localhost:5000",
    "start": "node server/index.js"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^1.4.5-lts.2"
  },
  "keywords": [
    "college-registration",
    "student-form",
    "excel-integration",
    "cv-upload"
  ],
